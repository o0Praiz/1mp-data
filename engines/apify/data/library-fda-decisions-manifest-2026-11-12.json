   "note": "the whole openFDA record as compact JSON with its keys sorted, minus the fields in drop_fields"
  },
  {
   "name": "record_fields",
   "type": "int32",
   "note": "number of top-level fields in record"
  },
  {
   "name": "record_len",
   "type": "int32",
   "note": "characters in record"
  },
  {
   "name": "dropped_fields",
   "type": "string",
   "note": "the drop_fields this record carried before they were removed, joined with |. Empty when none"
  },
  {
   "name": "application_number",
   "type": "string",
   "note": "drug/drugsfda and drug/orangebook. Empty elsewhere"
  },
  {
   "name": "recall_number",
   "type": "string",
   "note": "the three enforcement endpoints. Empty elsewhere"
  },
  {
   "name": "k_number",
   "type": "string",
   "note": "device/510k. Empty elsewhere"
  },
  {
