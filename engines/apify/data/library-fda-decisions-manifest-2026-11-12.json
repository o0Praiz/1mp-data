  },
  {
   "name": "product_code",
   "type": "string",
   "note": "device/510k, device/classification, device/pma and device/recall. Empty elsewhere"
  },
  {
   "name": "product_number",
   "type": "string",
   "note": "drug/orangebook. Empty elsewhere"
  },
  {
   "name": "event_id",
